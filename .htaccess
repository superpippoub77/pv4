<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Abilita rewrite per i file PHP
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite API endpoints
    RewriteRule ^api/auth$ api/auth.php [QSA,L]
    RewriteRule ^api/users(/.*)?$ api/users.php$1 [QSA,L]
    RewriteRule ^api/config$ api/config.php [QSA,L]
    RewriteRule ^api/exercises(/.*)?$ api/exercises.php$1 [QSA,L]
</IfModule>
